{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "aayanshaikh.vercel.app" }],
      "destination": "https://aayanshaikh.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.aayanshaikh.dev" }],
      "destination": "https://aayanshaikh.dev/:path*",
      "permanent": true
    }
  ]
}
