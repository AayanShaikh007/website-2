---
import Layout from '../layouts/Layout.astro';
import {lifeYears} from '../data/life';
---
<Layout title="Life — Aayan Shaikh" description="Notes from university, hackathons, travel, and building things.">
<section class="life-page wrap">
 <header class="life-header"><h1>Life</h1><p>Notes from university, hackathons, travel, and building things.</p></header>
 <nav class="life-years" aria-label="Journal years">{lifeYears.map(({year})=><a href={`#year-${year}`}>{year}</a>)}</nav>
 <div class="life-journal">{lifeYears.map(({year,entries})=><section class="life-year" id={`year-${year}`} aria-labelledby={`heading-${year}`}><h2 id={`heading-${year}`}>{year}</h2><div class="life-entries"><span class="journal-track" aria-hidden="true"><span class="journal-progress"></span></span>{entries.map(entry=><article class="life-entry" id={entry.slug} data-journal-entry><div class="life-entry-meta"><time datetime={entry.date}>{entry.dateLabel}</time><span>{entry.location}</span></div><h3>{entry.title}</h3><p class="life-subtitle">{entry.subtitle}</p><p>{entry.paragraphs[0]}</p>{entry.paragraphs.length>1&&<details class="life-story"><summary><span class="when-closed">Read entry</span><span class="when-open">Close entry</span></summary><div class="life-story-body">{entry.paragraphs.slice(1).map(paragraph=><p>{paragraph}</p>)}</div></details>}{entry.image&&<figure><img src={entry.image.src} alt={entry.image.alt} loading="lazy" width="1000" height="750"/>{entry.image.caption&&<figcaption>{entry.image.caption}</figcaption>}</figure>}</article>)}</div></section>)}</div>
</section>
</Layout>
<script>
import '../scripts/life-motion';
</script>
