---
import Layout from '../../layouts/Layout.astro';
import YouTubeCover from '../../components/YouTubeCover.astro';
import CadModel from '../../components/CadModel.astro';
import {projectModels} from '../../data/models';
import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}}));}
const {project:p,next}=Astro.props;
---
<Layout title={`${p.title} — Aayan Shaikh`} description={p.summary}>
<article class="case-study wrap">
<a class="text-link" href="/#projects">← All projects</a>
<header class="project-header"><p class="muted">{p.category}</p><h1>{p.title}</h1><p class="case-intro">{p.summary}</p><a class="button github-button" href={p.repo} target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.09-1.15 3.09-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.33-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z"/></svg>{p.profileOnly?'GitHub profile ↗':'View on GitHub ↗'}</a>{p.profileOnly&&<p class="repo-note">Project repository not publicly linked.</p>}{'source' in p && <a class="text-link project-source" href={p.source} target="_blank" rel="noopener noreferrer">{p.slug==='nanoquant'?'Validation notes ↗':'Project source ↗'}</a>}</header>
{p.slug==='karen' && <YouTubeCover poster={p.image} alt={p.alt}/>}
{p.gallery.length>0 && p.slug!=='karen' && <figure class="case-image"><a href={p.gallery[0].src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${p.title} overview`}><img src={p.gallery[0].src} alt={p.gallery[0].alt} width="1200" height="800" fetchpriority="high"/></a></figure>}
{p.gallery.length===0 && <p class="project-image-pending muted">Project photographs and screenshots will be added here.</p>}
{projectModels[p.slug] && <CadModel poster={p.image} {...projectModels[p.slug]}/>}
<section class="case-copy" aria-label="Project description">{p.paragraphs.slice(1).map(paragraph=><p>{paragraph}</p>)}</section>
{p.gallery.length>1 && <section class="project-gallery" aria-label={`${p.title} image gallery`}><h2>Images</h2><p class="muted gallery-hint">Select an image to view full size.</p><div class="gallery-grid">{(p.slug==='karen'?p.gallery:p.gallery.slice(1)).map((image,i)=><figure><a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`Open ${p.title} image ${i+2} full size`}><picture>{'poster' in image && typeof image.poster==='string' && <source media="(prefers-reduced-motion: reduce)" srcset={image.poster}/>}<img src={image.src} alt={image.alt} width="1000" height="750" loading="lazy"/></picture></a><figcaption>{'caption' in image && typeof image.caption==='string'?image.caption:`${p.title} · ${String(i+2).padStart(2,'0')}`}</figcaption></figure>)}</div></section>}
<a class="next-project" href={`/projects/${next.slug}/`}><span class="muted">Next project</span><h2>{next.title} ↗</h2></a>
</article></Layout>
